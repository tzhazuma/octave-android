# Build inputs / outputs that are large or regenerable -- NOT source of truth.
# Anchored: an unanchored `src/` also matched android-app/app/src/, so the entire
# Android application (Java, manifest, icons) was invisible to git.
/src/
prefix/
downloads/
backups/

# Compiled test binaries (keep the .c/.f90 sources instead)
spike/**/gate
spike/**/blas_gate
spike/**/lapack_gate
spike/**/lapack_gate_clean
spike/**/*.o
spike/**/*.a

# Bulky build logs; the small, meaningful ones are kept.
logs/openblas_make.log
logs/openblas_build.log
logs/openblas_shared.log
logs/fftw_make.log
logs/openblas_clapack_make.log

# Build artifacts: cross-compiled ELF shared objects / static archives.
# These are regenerable with scripts/build_*.sh and are far too large for git.
*.so
*.so.*
spike/**/*.a

# Scratch test binaries produced while probing (the .c/.f90 sources are kept).
spike/fortran-gate/rtgate_*
spike/fortran-gate/fortran_gate_android*
spike/blas-test/blas_shared
spike/blas-test/blas_static

# macOS
.DS_Store

# Verbose per-attempt build/configure logs (regenerable; the meaningful
# summaries live in STATUS.md and evidence/).
logs/octave_configure_run*.log
logs/octave_configure_full.log
logs/octave_make*.log
logs/fftwf_*.log
logs/libiconv_*.log
logs/deps_all.log
logs/dep_*.log

# --- Android build outputs (added 2026-10-19) ---
# Gradle's caches and intermediates are machine-local and regenerable; committing them
# made every build show up as a diff. Only sources, scripts and the icon set are tracked.
android-app/.gradle/
android-app/app/build/
android-app/build/
android-app/local.properties

# --- Android app: generated or built artefacts (added 2026-10-19) ---
# The bundled Octave tree is staged from prefix/ by scripts/stage-apk-assets.sh.
android-app/app/src/main/assets/oct/
# Prebuilt executables and libraries packaged as JNI libs.
android-app/app/src/main/jniLibs/**/*.so
android-app/app/build/
android-app/.gradle/

# Release artefacts are published as GitHub release assets, never committed.
*.apk
# Build outputs and probe objects: reproducible, and they made one commit enormous.
build/

# Build outputs were committed by mistake; they are large and machine-specific.
android-app/app/build/
android-gui-app/app/build/
android-gui-app/.gradle/
android-app/.gradle/

# Gradle caches: build state, not source.
.gradle/
**/.gradle/
build/
**/build/
